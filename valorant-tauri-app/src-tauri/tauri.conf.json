{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "valorant-app",
  "version": "0.1.3",
  "identifier": "com.valorant-app.guard",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "valorant-app",
        "width": 700,
        "height": 600,
        "minWidth": 700,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/app-icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "both",
        "template": "./build/nsis/installer.nsi",
        "languages": [
          "SimpChinese"
        ]
      }
    }
  }
}
